# Copy this file to .env and fill in real values. Never commit .env.

# --- Mode --------------------------------------------------------------
DEMO_MODE=true
TIGERGRAPH_AVAILABLE=false

# --- TigerGraph (only used when TIGERGRAPH_AVAILABLE=true) -------------
TG_HOST=https://your-instance.i.tgcloud.io
TG_USERNAME=
TG_PASSWORD=
TG_GRAPH_NAME=FraudInvestigation
TG_SECRET=

# --- LLM (optional -- falls back to deterministic template explanations
#     when unset, so the system is fully functional without a key) ------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- App / security ------------------------------------------------------
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./data/processed/cases.db

# Static demo API keys -> roles (replace with real auth for production)
API_KEY_ANALYST=analyst-key
API_KEY_ADMIN=admin-key
API_KEY_READONLY=readonly-key

# --- Agent safety rails ---------------------------------------------------
MAX_INVESTIGATION_STEPS=8
MAX_EVIDENCE_ROUNDS=2
CONFIDENCE_SUFFICIENT_THRESHOLD=0.75

# --- Risk bands (also visible/editable on the Admin page) -----------------
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70
